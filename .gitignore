# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Environments ---
.venv/
venv/
env/
.python-version

# --- Secrets & credentials (see SECURITY.md / AGENTS.md rule 1) ---
.env
.env.*
!.env.example
.databrickscfg
*.pem
*.key
*.p12
secrets/
.databricks/

# --- Data: nothing containing real or downloaded data is committed ---
# (see AGENTS.md rule 2 and docs/02_PUBLIC_DATA_STRATEGY.md)
data/raw/
data/interim/
data/external/
data/downloads/
data/output/
# The service inbox (ADR-0036). Everything in it is somebody's upload, and this
# directory lives inside the repository tree — so it is excluded **whole**, with no
# negation. `AGENTS.md` rule 2 forbids private production data anywhere here; this is
# the mechanism, not the reminder.
#
# There is deliberately no `!data/inbox/README.md` escape. `core.ignorecase` is true on
# Windows and macOS, so a negation for `README.md` also un-ignores `readme.md` — and an
# upload bundle that happened to contain one would be staged by `git add -A`. The
# explanation lives at `data/INBOX.md` instead, outside the target it describes.
data/inbox/
# Demo packs are derived from public corpora and rebuilt from source, never
# committed (ADR-0017). `*.csv` below already covers the tables; this covers
# meta.json too, so a pack directory is excluded whole.
demo/packs/
*.parquet
*.xlsx
*.csv
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.csv
*.db
*.sqlite3

# --- Models / caches ---
models/
.cache/
.hf_cache/
.spacy/
*.bin
*.onnx

# --- Outputs & runs ---
# Anchored: an unanchored `outputs/` also matches src/pii_reduction/outputs/,
# which would silently drop that package from every commit and from the wheel.
/outputs/
runs/
benchmark_results/
mlruns/
*.log
# Run journals (`pii-reduction-service --run-journal`). Metadata only, but on the
# Databricks path `RunSummary.outputs` holds real catalog.schema.table names, which
# AGENTS.md rule 1 keeps out of the repository. Write them outside the repo; this is
# the backstop for when someone does not.
*.jsonl

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (project config IS committed; local overrides are not) ---
.claude/settings.local.json
.claude/local/

# Jobs API payloads written while following resources/README.md: they carry the
# host, catalog and schema that must never be committed.
job.json
